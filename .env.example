DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arxiv_db

PYTHONPATH=.
APP_NAME="AI Research Assistant API"
APP_VERSION="4.0.0-dev"

# Docker Variables (Optional for local container setup)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=arxiv_db
POSTGRES_PORT=5432

# Embedding model
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"
EMBEDDING_DEVICE="cpu"
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# ANN index runtime tuning
HNSW_EF_SEARCH=100

# LLM provider
# Direct provider access is closed to new accounts, so the working
# combination is the gateway one: a base URL plus a gateway-form model id.
# For the direct path, leave LLM_BASE_URL empty and use the provider-native
# id (claude-haiku-4-5-20251001) instead. The two id forms are not
# interchangeable — the native id returns 404 through the gateway.
LLM_API_KEY=
LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_MODEL="anthropic/claude-haiku-4.5"
LLM_TIMEOUT_SECONDS=30